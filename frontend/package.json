{
    "name": "frets-frontend",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "packageManager": "pnpm@10.17.1",
    "engines": {
        "node": ">=22.12"
    },
    "scripts": {
        "dev": "vite --host 127.0.0.1",
